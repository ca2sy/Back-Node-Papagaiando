generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique
  senha            String
  nome             String
  tokenRecuperacao String?   @map("token_recuperacao")
  expiracaoToken   DateTime? @map("expiracao_token")

  perfis Perfil[]

  @@map("tb_usuarios")
}

model Perfil {
  id      String @id @default(uuid()) @db.Uuid
  nome    String
  urlFoto String @map("url_foto")

  usuarioId String  @map("usuario_id") @db.Uuid
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  categorias               Categoria[]
  botoes                   Botao[]
  personalizacoesCategoria PersonalizacaoCategoria[]
  personalizacoesBotao     PersonalizacaoBotao[]

  @@map("tb_perfis")
}

model Categoria {
  id        String  @id @default(uuid()) @db.Uuid
  nome      String
  urlImagem String  @map("url_imagem")
  padrao    Boolean @default(true)

  perfilId String? @map("perfil_id") @db.Uuid
  perfil   Perfil? @relation(fields: [perfilId], references: [id])

  botoes          Botao[]
  personalizacoes PersonalizacaoCategoria[]

  @@map("tb_categorias")
}

model Botao {
  id        String  @id @default(uuid()) @db.Uuid
  nome      String
  urlImagem String  @map("url_imagem")
  urlAudio  String  @map("url_audio")
  padrao    Boolean @default(true)

  categoriaId String    @map("categoria_id") @db.Uuid
  categoria   Categoria @relation(fields: [categoriaId], references: [id])

  perfilId String? @map("perfil_id") @db.Uuid
  perfil   Perfil? @relation(fields: [perfilId], references: [id])

  personalizacoes PersonalizacaoBotao[]

  @@map("tb_botoes")
}

model PersonalizacaoCategoria {
  id        String  @id @default(uuid()) @db.Uuid
  nome      String?
  urlImagem String? @map("url_imagem")

  categoriaId String    @map("categoria_id") @db.Uuid
  categoria   Categoria @relation(fields: [categoriaId], references: [id])

  perfilId String @map("perfil_id") @db.Uuid
  perfil   Perfil @relation(fields: [perfilId], references: [id])

  @@unique([categoriaId, perfilId])
  @@map("tb_personalizacoes_categoria")
}

model PersonalizacaoBotao {
  id        String  @id @default(uuid()) @db.Uuid
  nome      String?
  urlImagem String? @map("url_imagem")
  urlAudio  String? @map("url_audio")

  botaoId String @map("botao_id") @db.Uuid
  botao   Botao  @relation(fields: [botaoId], references: [id])

  perfilId String @map("perfil_id") @db.Uuid
  perfil   Perfil @relation(fields: [perfilId], references: [id])

  @@unique([botaoId, perfilId])
  @@map("tb_personalizacoes_botao")
}