generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique
  senha            String
  nome             String
  tokenRecuperacao String?
  expiracaoToken   DateTime?
  perfis           Perfil[]

  @@map("tb_usuarios")
}

model Perfil {
  id        String    @id @default(uuid()) @db.Uuid
  nome      String
  urlFoto   String
  usuarioId String?   @map("usuario_id") @db.Uuid
  usuario   Usuario?  @relation(fields: [usuarioId], references: [id])

  // a parte de categorias e os botões
  @@map("tb_perfis")
}

model Categoria {
  id        String  @id @default(uuid()) @db.Uuid
  nome      String
  urlImagem String  @map("url_imagem")
  padrao    Boolean @default(true)

  // nulo quando a categoria é padrão (não pertence a nenhum perfil)
  perfilId String? @map("perfil_id") @db.Uuid
  perfil   Perfil? @relation(fields: [perfilId], references: [id])

  botoes Botao[]

  @@map("tb_categorias")
}

model Botao {
  id        String  @id @default(uuid()) @db.Uuid
  nome      String
  urlImagem String  @map("url_imagem")
  urlAudio  String  @map("url_audio")
  padrao    Boolean @default(true)

  categoriaId String    @map("categoria_id") @db.Uuid
  categoria   Categoria @relation(fields: [categoriaId], references: [id])

  @@map("tb_botoes")
}